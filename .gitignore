# Data: never commit the dataset or derived files (CDLA-Sharing 1.0)
/data/
*.csv
*.parquet
*.duckdb
*.duckdb.wal

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Claude Code local settings
.claude/settings.local.json

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Scripted-provider runs are harness checks, never results
evals/runs/**/scripted-*.json
evals/runs/**/bakeoff-scripted-*.json
# Debug dumps hold tool outputs (transaction rows): never commit
evals/runs/**/debug/

# UI build output and dependencies
ui/node_modules/
ui/dist/
evals/runs/**/triage-scripted-*.json
# Progress files of interrupted runs; the final result file holds every case
evals/runs/**/progress-*.jsonl
