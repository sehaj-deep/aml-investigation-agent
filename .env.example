# Copy to .env (gitignored). No secrets belong in this file.
# Folder holding HI-Small_Trans.csv, HI-Small_accounts.csv, HI-Small_Patterns.txt.
AML_DATA_DIR=D:/Coding/AI_Agents/archive
# Where the converted Parquet files go (inside the repo, gitignored).
PARQUET_DIR=data/parquet

POSTGRES_USER=aml
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=aml
POSTGRES_PORT=5432

# Model provider: "scripted" (deterministic, no model; for tests and a working stack
# before Ollama is set up) or "ollama" (cloud models through the local Ollama app).
LLM_PROVIDER=scripted
LLM_MODEL=gpt-oss:20b-cloud
# From inside Docker, the Ollama app on Windows is reached through the host gateway.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Analysts see payment format and every date; set false to hide them for a comparison run.
TOOLS_SHOW_PAYMENT_FORMAT=true
TOOLS_SHOW_LATE_ROWS=true
# Read-only role the tool server uses to search the AML guidance (scripts/load_guidance.py).
GUIDANCE_READER_PASSWORD=change-me
